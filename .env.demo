# Modo demonstração (npm run dev:demo): sem login e sem Supabase.
# Os dados ficam no localStorage do navegador e começam com a carga inicial.
VITE_DEMO=true
# O cliente do Supabase é criado ao carregar o app, então precisa de valores,
# mesmo que o modo demonstração nunca fale com ele.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=modo-demonstracao
